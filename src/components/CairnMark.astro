---
// The mark: a cairn in one colour, like a glyph. `.cairn.building` plays it as a spinner, stone by stone up and
// back down, the way Claude Code's spinner walks its frames forward and back.
---

<svg class="cairn" viewBox="0 0 24 24" aria-hidden="true">
	<ellipse class="stone" style="--n:0" cx="12" cy="20.2" rx="9" ry="2.6"></ellipse>
	<ellipse
		class="stone"
		style="--n:1"
		cx="12.4"
		cy="15"
		rx="6.6"
		ry="2.3"
		transform="rotate(-3 12.4 15)"
	></ellipse>
	<ellipse
		class="stone"
		style="--n:2"
		cx="11.6"
		cy="10.4"
		rx="4.6"
		ry="2.1"
		transform="rotate(4 11.6 10.4)"
	></ellipse>
	<ellipse
		class="stone"
		style="--n:3"
		cx="12.3"
		cy="6.2"
		rx="2.9"
		ry="1.9"
		transform="rotate(-5 12.3 6.2)"
	></ellipse>
</svg>

<style is:global>
	.cairn {
		fill: currentColor;
		overflow: visible;
	}
	/* Once, where the mark first appears: each stone is set down on the one below. */
	.cairn .stone {
		animation: cairn-set var(--md-sys-motion-spring-default-spatial-duration)
			var(--md-sys-motion-spring-default-spatial) both;
		animation-delay: calc(var(--n) * 150ms + 200ms);
	}
	@keyframes cairn-set {
		from {
			opacity: 0;
			translate: 0 -5px;
		}
	}
	/* As a spinner: four frames of 150 ms, the stack one stone taller in each, played forward then back. */
	.cairn.building .stone,
	a:hover > .cairn .stone {
		animation: cairn-frames 600ms steps(1) infinite alternate;
		animation-delay: 0s;
	}
	.cairn.building .stone:nth-child(2),
	a:hover > .cairn .stone:nth-child(2) {
		animation-name: cairn-frames-2;
	}
	.cairn.building .stone:nth-child(3),
	a:hover > .cairn .stone:nth-child(3) {
		animation-name: cairn-frames-3;
	}
	.cairn.building .stone:nth-child(4),
	a:hover > .cairn .stone:nth-child(4) {
		animation-name: cairn-frames-4;
	}
	@keyframes cairn-frames {
		from,
		to {
			opacity: 1;
		}
	}
	@keyframes cairn-frames-2 {
		0% {
			opacity: 0;
		}
		25%,
		100% {
			opacity: 1;
		}
	}
	@keyframes cairn-frames-3 {
		0%,
		25% {
			opacity: 0;
		}
		50%,
		100% {
			opacity: 1;
		}
	}
	@keyframes cairn-frames-4 {
		0%,
		50% {
			opacity: 0;
		}
		75%,
		100% {
			opacity: 1;
		}
	}
</style>
